<?php

use PrAnd\Vendor\Api\Data\VendorInterface;

/** @var VendorInterface[] $vendors */
/** @var Magento\Catalog\Block\Product\View $block */
$viewModel = $block->getData('viewModel');
$vendors = $viewModel->getData($block->getProduct());
?>

<div class="vendor">
    <?php foreach ($vendors as $vendor) : ?>
        <?php if(!empty($vendor->getImage())) : ?>
            <div class="vendor-image">
                <img src="<?php echo $vendor->getImage(); ?>" alt="<?php echo $vendor->getName(); ?>" class="vendor__image img-fluid">
            </div>
        <?php endif; ?>

        <div class="vendor__name">
            <?php echo $vendor->getName(); ?>
        </div>
    <?php endforeach; ?>
</div>

